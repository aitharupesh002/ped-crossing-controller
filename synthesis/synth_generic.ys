# Technology-independent Yosys synthesis. Run from project root:  yosys -l synthesis/yosys_log.txt synthesis/synth_generic.ys
read_verilog src/ped_crossing_ctrl.v
hierarchy -check -top ped_crossing_ctrl
proc
opt_clean
# 'check -assert' fails on combinational loops, multiple drivers, undriven nets
check -assert
synth -top ped_crossing_ctrl -flatten
check -assert
tee -o synthesis/stat_generic.txt stat
write_verilog -noattr synthesis/ped_crossing_ctrl_generic_netlist.v
